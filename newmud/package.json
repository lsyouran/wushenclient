{
  "name": "newmud-project",
  "version": "0.0.0",
  "private": true,
  "description": "基于 wushen 设计思路重写的 TypeScript MUD（阶段 0：契约与骨架）",
  "type": "module",
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "start": "node tools/start.mjs",
    "prestart": "npm run build:web",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "gate": "node tools/gate/run-all.mjs",
    "gate:mutation": "node tools/gate/mutation-test.mjs",
    "build:web": "tsc -p tsconfig.web.json && node tools/copy-web-assets.mjs",
    "check": "npm run typecheck && npm run test && npm run gate"
  },
  "dependencies": {
    "ws": "^8.22.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/ws": "^8.18.2",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "vitest": "^5.0.3"
  }
}
