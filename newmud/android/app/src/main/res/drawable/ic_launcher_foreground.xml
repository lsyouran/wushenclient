<?xml version="1.0" encoding="utf-8"?>
<!--
  像素风徽记：一个戴斗笠、佩剑的侠客（与 `ui/Widgets.kt#PixelMark` **同一份 16×16 设计**）。

  ★ 为什么是"几个矩形"而不是一条曲线路径：
    像素画的语义就是格子 —— 每个色块是整数格，边界要么全占要么不占。
    用 `M`/`h`/`v`/`z` 的矩形路径画出来的就是硬边，不会像曲线那样在缩放时变糊。
  ★ 为什么手写坐标而不生成：这份图只用一次，生成器的成本远超两个文件。
    代价是**改设计要改两处**（这里 + `PixelMark`），这一点在两处注释里都写明了。

  ★ 为什么从"一把剑"改成"一个人"：剑在 16×16 里只能是一条竖线，缩到 44dp 和
    "一条分隔线"长得一模一样；人形有**斗笠的横檐 + 肩膀 + 腰带**三道横线，
    缩到最小也还是个人。佩剑留着（右侧竖着），但它是配件不是主体。

  坐标系：108×108 是 adaptive icon 的标准画布，其中只有中间 72×72 可见、
  66×66 保证不被各种形状（圆形/方圆形/水滴）裁掉。
  ⇒ 16 格 × 4px = 64px，居中后左上角在 (22,22)。
    下面每个矩形的 x/y 都是 `22 + 格位×4`，宽高是 `格数×4`。
    注释里的格位区间写成**半开**（`x12..16` = x 从 12 起占 4 格，即 12,13,14,15），
    这样"区间长度 = 格数"能直接对得上，不用在两种记法之间换算。
  全部内容落在 x 34..86、y 26..78（含端点），在 66 格安全区内。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- ── 佩剑（先画，压在人形后面）── -->
    <!-- 剑身：x13..15 / y1..7 -->
    <path
        android:fillColor="#8A93A5"
        android:pathData="M74,26h8v24h-8z" />
    <!-- 护手：x12..16 / y7..8 -->
    <path
        android:fillColor="#D3B168"
        android:pathData="M70,50h16v4h-16z" />
    <!-- 剑柄：x13..15 / y8..10 -->
    <path
        android:fillColor="#D3B168"
        android:pathData="M74,54h8v8h-8z" />
    <!-- 握剑的手：x12..13 / y8..9 -->
    <path
        android:fillColor="#D8DCE4"
        android:pathData="M70,54h4v4h-4z" />

    <!-- ── 斗笠 ── -->
    <!-- 笠顶：x5..11 / y1..2 -->
    <path
        android:fillColor="#D3B168"
        android:pathData="M42,26h24v4h-24z" />
    <!-- 笠檐：x3..13 / y2..3 -->
    <path
        android:fillColor="#D3B168"
        android:pathData="M34,30h40v4h-40z" />

    <!-- ── 人形 ── -->
    <!-- 脸：x6..10 / y3..5 -->
    <path
        android:fillColor="#D8DCE4"
        android:pathData="M46,34h16v8h-16z" />
    <!-- 肩：x5..11 / y5..6 -->
    <path
        android:fillColor="#7FB3A3"
        android:pathData="M42,42h24v4h-24z" />
    <!-- 两袖：x4..12 / y6..8 -->
    <path
        android:fillColor="#7FB3A3"
        android:pathData="M38,46h32v8h-32z" />
    <!-- 腰带：x4..12 / y8..9 -->
    <path
        android:fillColor="#D3B168"
        android:pathData="M38,54h32v4h-32z" />
    <!-- 下摆：x5..11 / y9..11 -->
    <path
        android:fillColor="#7FB3A3"
        android:pathData="M42,58h24v8h-24z" />
    <!-- 左腿：x5..7 / y11..13 -->
    <path
        android:fillColor="#3E5B53"
        android:pathData="M42,66h8v8h-8z" />
    <!-- 右腿：x9..11 / y11..13 -->
    <path
        android:fillColor="#3E5B53"
        android:pathData="M58,66h8v8h-8z" />
    <!-- 左足：x4..7 / y13..14 -->
    <path
        android:fillColor="#3E5B53"
        android:pathData="M38,74h12v4h-12z" />
    <!-- 右足：x9..12 / y13..14 -->
    <path
        android:fillColor="#3E5B53"
        android:pathData="M58,74h12v4h-12z" />
</vector>
