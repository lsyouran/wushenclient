<?xml version="1.0" encoding="utf-8"?>
<!--
  自适应图标（API 26+）。

  ★ 只有 `mipmap-anydpi-v26` 一份，没有各密度的 PNG —— 因为 `minSdk = 26`
    （`app/build.gradle.kts`），**所有**目标设备都支持自适应图标。
    一旦有朝一日把 minSdk 降到 25 或更低，这里必须补 `mipmap-*/ic_launcher.png`
    的兜底，否则老机器上图标会变成空白方块。
  ★ 不写 `<monochrome>`：那是 API 33 的主题图标（图标随壁纸取色），
    放在 v26 目录里对部分厂商的 ROM 是未定义行为。要做就该另起 `mipmap-anydpi-v33`。
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
