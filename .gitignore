# ────────────────────────────────────────────────────────────────
# ts-mud 仓库根 .gitignore
# 子目录 newmud/ 另有一份自己的 .gitignore（依赖/构建/变异夹具）。
# 本文件只管根层（docs/、wushen/、根报告、一次性证据）。
#
# ⚠️ 注意：.gitignore **不支持行内注释** —— `#` 只有在行首才是注释，
#    写在规则后面会被当成规则的一部分（静默失效）。故此文件注释一律独立成行。
# ────────────────────────────────────────────────────────────────

# 依赖（匹配任意层级，含 newmud/ 与 wushen/）
node_modules/

# 构建产物 / 增量信息
dist/
*.tsbuildinfo

# 运行时数据与日志
*.db
*.db-journal
*.db-wal
*.db-shm
/data/
log/
logs/

# 编辑器 / 系统
.vscode/
.idea/
.DS_Store
Thumbs.db

# ── 变异测试夹具：保留命名空间 ───────────────────────────────────
# 受限环境禁止批量删除，夹具"还原"= 把内容写空 ⇒ 长期存在 0 字节空壳。
# lib.mjs 的 walk() 跳过零字节文件，故不干扰闸门；但**不入库**。
__mut*
*.mutbak

# ── 一次性证据 / 临时物（体积大、可由脚本再生）──────────────────
# _bench-* 存档基准(54M)、_shots-* 无头截图(3.6M)、
# _tmp-trash 夹具空壳集散地、_deprecated-* 已废弃旧前端、_*.log 内环日志。
_bench-*/
_shots-*/
_tmp-trash/
_deprecated-*/
_*.log
*.log

# ── 压缩包 / 大二进制 ────────────────────────────────────────────
*.7z
*.zip
*.rar
*.tar
*.gz

# ── WorkBuddy 工具状态 ──────────────────────────────────────────
# 本项目的 .workbuddy/memory/ 是**决策日志**（长期价值），故放行；
# 其余工具产物不入库。
.workbuddy/*
!.workbuddy/memory/

# ── wushen 原版参考源码 ─────────────────────────────────────────
# 保留源码与资源（是 specs 的引用对象），排除其依赖与运行时产物。
wushen/log/
wushen/data/
